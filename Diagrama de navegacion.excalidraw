    {
      "id": "VueE8SW9fY6tmKwCzuLwk",
      "type": "text",
      "x": -341.39735645073006,
      "y": -1710.1599866101678,
      "width": 450.8395690917969,
      "height": 918,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 600765168,
      "version": 837,
      "versionNonce": 2063725584,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795208185526,
      "link": null,
      "locked": false,
      "text": "1) Facturacion (Lista y busqueda)\n    1.1l)Generar factura\n    1.2)Generar reporte\n    1.2)Anular\n    1.3)Abonar\n2)Certificados (Lista y busqueda)\n    2.1)Reimprimir\n    2.2)Emitir\n3)Notas (Lista y busqueda)\n    3.1)Subir notas (incluye solicitar modificacion)\n    3.2)Aprobar o declinar solicitud de modificacion\n4)Inscripciones (Lista y busqueda)\n    4.1)Inscribir\n    4.2)Retirar\n5)Periodos (Lista y busqueda)\n    5.1)Agregar\n    5.2)Editar\n    5.3)Cerrar\n6)Estudiantes (Lista y busqueda)\n    6.1)Agregar nuevo\n    6.2)Subir documento\n    6.3)Descargar documento\n    6.4)Imprimir carnet\n    6.5)Actualizar foto\n    6.6)Desactivar\n7)Profesores (Lista y busqueda)\n    7.1)Agregar\n    7.2)Desactivar\n8)Usuarios (Lista y busqueda)\n    8.1)Agregar\n    8.2)Desactivar\n9)Historial (Listar y buscar)\n10)Configuracion (Listar y buscar)\n    10.1)Modificar precios",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Facturacion (Lista y busqueda)\n    1.1l)Generar factura\n    1.2)Generar reporte\n    1.2)Anular\n    1.3)Abonar\n2)Certificados (Lista y busqueda)\n    2.1)Reimprimir\n    2.2)Emitir\n3)Notas (Lista y busqueda)\n    3.1)Subir notas (incluye solicitar modificacion)\n    3.2)Aprobar o declinar solicitud de modificacion\n4)Inscripciones (Lista y busqueda)\n    4.1)Inscribir\n    4.2)Retirar\n5)Periodos (Lista y busqueda)\n    5.1)Agregar\n    5.2)Editar\n    5.3)Cerrar\n6)Estudiantes (Lista y busqueda)\n    6.1)Agregar nuevo\n    6.2)Subir documento\n    6.3)Descargar documento\n    6.4)Imprimir carnet\n    6.5)Actualizar foto\n    6.6)Desactivar\n7)Profesores (Lista y busqueda)\n    7.1)Agregar\n    7.2)Desactivar\n8)Usuarios (Lista y busqueda)\n    8.1)Agregar\n    8.2)Desactivar\n9)Historial (Listar y buscar)\n10)Configuracion (Listar y buscar)\n    10.1)Modificar precios",
      "autoResize": true,
      "lineHeight": 1.35
    },
